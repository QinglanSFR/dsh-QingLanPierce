{
  "name": "dsh-QingLanPierce",
  "version": "0.1.0-beta.5",
  "description": "QingLan · DeepSeek Harness 破甲中枢 · 免费开源 · 禁止违法用途 · 仅供学习！",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "cordis"
  ],
  "engines": {
    "node": ">=20.11",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "prompts",
    "prompts/examples",
    "README.md",
    "LICENSE",
    "install.ps1",
    "uninstall.ps1",
    "install.sh",
    "uninstall.sh"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "id": "dsh-QingLanPierce",
    "name": "QingLan破甲插件",
    "version": "0.1.0-beta.5",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "repo": "QinglanSFR/dsh-QingLanPierce"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QinglanSFR/dsh-QingLanPierce.git"
  },
  "homepage": "https://github.com/QinglanSFR/dsh-QingLanPierce"
}
