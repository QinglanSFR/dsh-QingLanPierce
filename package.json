{
  "name": "dsh-QingLanPierce",
  "version": "0.1.1-beta.1",
  "description": "QingLan · DeepSeek Harness 破甲中枢 · 免费开源 · 禁止违法用途 · 仅供学习！",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "cordis"
  ],
  "engines": {
    "node": ">=20.11",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.2-rc.3 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "prompts",
    "prompts/examples",
    "assets",
    "README.md",
    "LICENSE",
    "install.ps1",
    "uninstall.ps1",
    "install.sh",
    "uninstall.sh"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/config.js && node --check lib/core.js && node --check lib/lexicon.js && node --check lib/notation.js",
    "verify": "node scripts/verify.mjs",
    "build": "node scripts/build.mjs",
    "fix-bom": "node scripts/fix-bom.mjs",
    "e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-install.ps1"
  },
  "dsh": {
    "id": "dsh-QingLanPierce",
    "name": "QingLan破甲插件",
    "version": "0.1.1-beta.1",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "repo": "QinglanSFR/dsh-QingLanPierce"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QinglanSFR/dsh-QingLanPierce.git"
  },
  "homepage": "https://github.com/QinglanSFR/dsh-QingLanPierce"
}
